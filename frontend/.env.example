# =============================================================================
# MAANMITRA Frontend — Environment Variables Reference
# =============================================================================

# Backend API base URL (must include /api/v1)
# Local dev:
VITE_API_URL=http://localhost:8000/api/v1

# WebSocket base URL (ws:// for local, wss:// for production)
# Local dev:
VITE_WS_URL=ws://localhost:8000/api/v1

# Razorpay publishable key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXX
