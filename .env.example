# =============================================================================
# MAANMITRA — Environment Variables Reference
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (Render PostgreSQL — use internal URL for backend service)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://maanmitra_user:YOUR_DB_PASSWORD@dpg-XXXX-a.virginia-postgres.render.com/maanmitra

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# MUST be a long (32+ char) random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=720

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed frontend origins)
# For local dev: http://localhost:5173
# For production: https://maanmitra.onrender.com,https://www.maanmitra.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway
# Get keys from: https://dashboard.razorpay.com/app/keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXX
